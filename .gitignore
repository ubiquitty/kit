build/
# macOS swap / document-recovery files (.!NNNNN! pattern)
.!*!
# Every out-of-tree build/scratch dir. Named ones kept reappearing untracked
# (BuildBench, BuildPGOTrain, …); the pattern covers the next one.
Build*/
*.o
*.obj
*.bak
*.zip
.DS_Store
*.d
*.dia
*.swiftconstvalues
# Editor / IDE
.vscode/
.idea/
*.swp
\#*\#
# clangd index + compile DB (per-checkout, regenerated by the build)
.cache/
compile_commands.json
# Python
__pycache__/
*.pyc
# Local Claude Code metadata
.claude/
# Swift incremental-compile dependency files, when a build drops them in the
# checkout instead of its build directory.
*.swiftdeps
# Swift PGO trains per machine: front-end instrumentation keys functions by
# absolute compile path, so the artifact cannot be shared.
Support/pgo/swift-renderkit.profdata
Support/pgo/swift-renderkit.trained-at
